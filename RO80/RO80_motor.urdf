<?xml version='1.0' encoding='utf-8'?>
<!--
  CubeMars RO80 + Harmonic Gearbox (output side, post-gearbox)
  - 측정 데이터(OutputEncoder) 가 기어박스 출력단 기준이므로 URDF 도 출력단 기준으로 정의
  - Gear ratio N = 23.04 (100% 효율 가정 — 단방향 reflection)
      θ_out      = θ_motor / N
      ω_out      = ω_motor / N
      τ_out      = τ_motor * N
      J_out      = J_motor * N²       (반사관성)
      D_out      = D_motor * N²       (점성 댐핑 반사)
      F_out      = F_motor * N        (쿨롬 마찰 반사)
  - 외부 링크/페이로드 없음 → 출력축 자체 동역학만 평가
  - 출력단 반사관성은 URDF 에 넣지 않고 actuator armature 로 전부 흡수
    → pace/CMA-ES 가 찾은 armature 값이 곧 effective output-side joint inertia
    → URDF 의 ixx 는 수치 안정용 미세값 (1e-9) 만 부여

  스펙 (CubeMars RO80, 48V, N=23.04 기어박스 후 출력단 환산)
    [기계 — 출력단 기준]
      Reflected rotor inertia : 1.60e-4 * 23.04² ≈ 8.49e-2 kg·m²  ← armature 초기 추정치 (출력단)
      Reflected cogging       : 0.024 * 23.04   ≈ 0.553 N·m       ← friction 초기 추정치 (출력단)
      Mass                    : 로터 85 g, 스테이터 180 g, 전체 265 g (모터 본체)
      극 쌍 수                : 21
      Insulation              : Class F, 500 V, 10 MΩ
      Operating temp          : -20 ~ 50 ℃
    [전기 — 모터단 (참고용, 변환 X)]
      Torque const Kt    : 0.087 N·m/A
      Back-EMF Kb        : 9.07 V/krpm = 0.0866 V·s/rad
      Speed const        : 105 rpm/V
      Motor const Km     : 0.25 N·m/√W
      선간 저항 R_LL     : 120 mΩ   (delta 결선: phase R ≈ 180 mΩ)
      선간 인덕턴스 L_LL : 103 μH
      Mechanical τ_m     : 2.95 ms
      Electrical τ_e     : 0.86 ms
      Winding type       : delta, FOC 제어
    [성능 한계 — 출력단 기준]
      Peak torque        : 4 * 23.04   = 92.16 N·m   (모터 50 A peak)
      Rated torque       : 1.3 * 23.04 = 29.95 N·m   (모터 15 A rated)
      No-load speed      : 527.79 / 23.04 ≈ 22.91 rad/s
      Rated speed        : 376.99 / 23.04 ≈ 16.36 rad/s
      Rated voltage      : 48 V
    [참고: 출력단 viscous damping 의 실제 크기]
      - 단순 ×N² 반사 (D_motor=0.06 → D_out=31.85) 는 과대평가:
        모터단 전기 댐핑은 FOC 가 back-EMF 보상하면서 실효값이 작아짐
        실제 출력단 점성의 주성분은 기어박스 출력 베어링/그리스 손실
      - 전형적 harmonic-gearbox + RO80 급 액추에이터: 0.5 ~ 3 N·m·s/rad
      - 아래 default 1.0 은 placeholder — fit_actuator/CMA-ES 가 튜닝
-->
<robot name="RO80_motor">

  <!-- World base (Isaac Lab: articulation은 world link에 fix로 고정) -->
  <link name="world"/>

  <!-- Stator: static body, 질량/관성 무시 (world에 fix되므로 물리 영향 없음) -->
  <link name="stator">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.180"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.040" length="0.040"/>
      </geometry>
      <material name="stator_gray">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
  </link>

  <joint name="stator_fix" type="fixed">
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="stator"/>
  </joint>

  <!--
    Output-shaft link (gearbox output, post-reduction)
    * 회전축 inertia (ixx) = 1e-9: 수치 안정용 미세값.
      → 회전 dynamics 는 actuator armature 가 전부 담당
      → pace 가 찾은 armature 값이 곧 effective output-side joint inertia
        (기대값 ≈ 1.60e-4 * 23.04² ≈ 0.0849)
    * iyy/izz: revolute joint(X축) 동역학과 무관 → 형상 근사치 (mass=85g 기준)
      (1/4)mr² + (1/12)mh² = (1/4)(0.085)(0.036²) + (1/12)(0.085)(0.032²) ≈ 3.48e-5
  -->
  <link name="rotor">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.085"/>
      <inertia ixx="1e-9" ixy="0" ixz="0"
               iyy="3.48e-5" iyz="0"
               izz="3.48e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.032"/>
      </geometry>
      <material name="rotor_orange">
        <color rgba="0.8 0.4 0.1 1"/>
      </material>
    </visual>
    <!-- 회전 시각 확인용 indicator (스테이터 바깥으로 노출) -->
    <visual>
      <origin xyz="0.024 0 0.018" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.006 0.064"/>
      </geometry>
      <material name="indicator_red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <!--
    Output joint (post-gearbox hinge about X)
    * effort   = Peak torque * N = 4 * 23.04 = 92.16 Nm
    * velocity = 1500.0 rad/s (input encoder multi-turn fitting headroom)
        - input-side 데이터는 motor-shaft rad 이므로 수십 rad 범위의 multi-turn trajectory.
        - PhysX clamp 방지를 위해 continuous joint 와 넉넉한 velocity 로 설정.
    * damping  = 1.0 N·m·s/rad   (출력단 점성 — placeholder, ×N² naive 반사 X)
    * friction = F_motor * N  = 0.024 * 23.04 ≈ 0.553 N·m         (출력단 쿨롬)
    * 위 dynamics 값은 default — fit_actuator/CMA-ES 가 출력단 스케일에서 튜닝
  -->
  <joint name="J1" type="continuous">
  <!-- ! stator 프레임 기준으로 rotor 의 위치와 회전 (출력단 좌표계) -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="stator"/>
    <child link="rotor"/>
    <!-- ! 월드 기준 x축 -->
    <axis xyz="1 0 0"/>
    <limit effort="92.16" velocity="1500.0"/>
    <dynamics damping="1.0" friction="0.553"/>
  </joint>

</robot>
